47-107-104-106.sslip.io {
    encode zstd gzip

    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /health {
        reverse_proxy 127.0.0.1:8000
    }

    handle /admin* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /static/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /updates/* {
        root * /srv/mixcut
        file_server
        header Cache-Control "public, max-age=300"
    }

    respond "Mixcut service online" 200

    log {
        output file /var/log/caddy/mixcut-access.log {
            roll_size 20MiB
            roll_keep 5
        }
    }
}
