# MixcutAI 开发环境变量模板。复制为 .env 后自行填写，不要提交真实值。

# 通用 API 示例
API_KEY=
BASE_URL=
CLIENT_ID=
CLIENT_SECRET=

# YouTube Desktop OAuth
MIXCUT_YOUTUBE_CLIENT_ID=
MIXCUT_YOUTUBE_CLIENT_SECRET=
MIXCUT_OAUTH_REDIRECT_URI=http://127.0.0.1:17866/api/oauth/callback

# 本地运行目录（可选）
MIXCUT_APP_HOME=
MIXCUT_DATA_DIR=
MIXCUT_ADMIN_MODE=0

# 授权服务器/管理员工具专用。用户客户端不要配置私钥。
MIXCUT_LICENSE_PRIVATE_KEY=
MIXCUT_PRIVATE_KEY=
MIXCUT_SESSION_SECRET=
MIXCUT_PEPPER_FILE=

